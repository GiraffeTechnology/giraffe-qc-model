# qc-vlm-probe pass/fail gate thresholds.
#
# Loaded by lib/score.py:load_gates(). A blank or "TBD" value is stored as
# None; verdict_for() reports INCONCLUSIVE rather than guess a threshold that
# was never actually agreed with the business.
#
# false_accept_rate_max / false_reject_rate_max are intentionally blank: no
# one has yet stated the acceptable false-accept and false-reject rates for
# this QC line. Set them (as fractions, e.g. 0.02) before a scoring run is
# read as a go/no-go decision -- until then every model verdict is
# INCONCLUSIVE by design, never PASS.
false_accept_rate_max=
false_reject_rate_max=

# Operator-facing SLO: 95th percentile end-to-end (encode + request + retry
# backoff) must stay under 10s per sample.
latency_p95_ms_max=10000

# Above this fraction of cells failing to parse as JSON, the prompt/response
# contract itself is broken and accuracy numbers from the run are not
# trustworthy regardless of what they say.
parse_failure_rate_max=0.01
