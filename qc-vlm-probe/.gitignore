# Sample images and ground truth are customer product photographs supplied
# at runtime only. They must never be committed and never leave this machine
# except as API payloads sent directly by qc-probe.sh.
samples/*
!samples/.gitkeep

# Run outputs (raw API responses, report.json/report.md) are regenerated by
# qc-probe.sh and may embed sample content (e.g. failure-gallery excerpts).
results/*
!results/.gitkeep
